# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
# Database (default when unset: SQLite file in backend/data/optistore.db)
# DATABASE_URL=postgresql+psycopg://optistore:change-me@localhost:5432/optistore
# POSTGRES_PASSWORD=change-me

# Folders that may be analysed (separate with ";" or ","). Default: ./sample_data
# ALLOWED_SCAN_ROOTS=C:/Users/me/Documents/shared;C:/data/archive

# Optional shared secret: when set, every /api call needs header X-API-Key.
# API_KEY=

# CORS_ORIGINS=http://localhost:5173

# Limits
# MAX_FILE_SIZE_MB=512
# MAX_TEXT_EXTRACT_MB=25

# Embeddings: "sentence-transformers" (default) or "hashing" (lexical fallback, no download)
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AWS (optional). Prefer a named profile or an IAM role over static keys.
# AWS_PROFILE=optistore-readonly
# AWS_REGION=us-east-1
# ALLOWED_S3_BUCKETS=my-bucket,another-bucket
# S3_WRITE_ENABLED=false
# S3_MAX_DOWNLOAD_MB=10
# PRICING_FILE=/path/to/custom_pricing.json
